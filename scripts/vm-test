set -euo pipefail

VM_NAME="${DP2_VM_NAME:-dp2-test}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET_DIR="${DP2_VM_TARGET_DIR:-/tmp/dp2-target}"

MODEL_PATH="${REPO_ROOT}/models/depthpro2-s-stream4.onnx"
VIDEO_PATH="${REPO_ROOT}/testdata/flower.webm"

if [ ! -f "${MODEL_PATH}" ] || [ ! -f "${VIDEO_PATH}" ]; then
  echo "Missing model or video fixture; run scripts/vm-setup first." >&2
  exit 1
fi

orb -m "${VM_NAME}" bash -lc "
  set -euo pipefail
  cd '${REPO_ROOT}'
  export CARGO_TARGET_DIR='${TARGET_DIR}'
  export DP2_MODEL_PATH='${MODEL_PATH}'
  export DP2_TEST_VIDEO='${VIDEO_PATH}'
  export ORT_DYLIB_PATH=\"\$(ldconfig -p | awk '/libonnxruntime\\.so/ {print \$NF; exit}')\"
  echo \"Using ORT_DYLIB_PATH=\${ORT_DYLIB_PATH}\"

  cargo clippy --locked --workspace --all-targets -- --deny warnings
  cargo test --locked --workspace
  cargo test --locked -p dp2 --test pipewire_integration -- --ignored --nocapture --test-threads=1
"
