set -euo pipefail

VM_NAME="${DP2_VM_NAME:-dp2-test}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODEL_DIR="${REPO_ROOT}/models"
TESTDATA_DIR="${REPO_ROOT}/testdata"

MODEL_URL="https://huggingface.co/christianengel/DepthPro2-S-ONNX/resolve/main/onnx/model_stream4.onnx"
MODEL_PATH="${MODEL_DIR}/depthpro2-s-stream4.onnx"

VIDEO_URL="https://interactive-examples.mdn.mozilla.net/media/cc0-videos/flower.webm"
VIDEO_PATH="${TESTDATA_DIR}/flower.webm"

ORT_WHEEL_URL="https://files.pythonhosted.org/packages/b7/30/103820b32e9dc1d1fcfc5b519fd2de5bd699d25a25895caf5d726350d1b5/onnxruntime-1.32.0-cp311-cp311-manylinux_2_28_aarch64.whl"
ORT_DIR="/opt/dp2-ort"
ORT_LIB="${ORT_DIR}/libonnxruntime.so.1.32.0"

mkdir -p "${MODEL_DIR}" "${TESTDATA_DIR}"

if ! orb list | awk '{print $1}' | grep -qx "${VM_NAME}"; then
  echo "Creating OrbStack Linux VM '${VM_NAME}' (fedora:44)..."
  orb create fedora:44 "${VM_NAME}"
fi

echo "Installing Linux build and PipeWire test dependencies in '${VM_NAME}'..."
orb -m "${VM_NAME}" sudo dnf install -y \
  cargo \
  clang-devel \
  clippy \
  ffmpeg-free \
  gcc \
  gstreamer1 \
  gstreamer1-plugins-base \
  gstreamer1-plugins-good \
  pipewire \
  pipewire-devel \
  pipewire-gstreamer \
  pipewire-utils \
  pkgconf-pkg-config \
  python3 \
  rust \
  rustfmt \
  wireplumber

orb -m "${VM_NAME}" bash -lc "
  set -euo pipefail
  if [ ! -f '${ORT_LIB}' ]; then
    echo 'Installing ONNX Runtime 1.32.0 shared library in ${ORT_DIR}...'
    sudo mkdir -p '${ORT_DIR}'
    sudo chown \"\$(id -u):\$(id -g)\" '${ORT_DIR}'
    tmp_whl=\$(mktemp /tmp/ort-XXXXXX.whl)
    trap 'rm -f \"\$tmp_whl\"' EXIT
    curl -fsSL --retry 3 -o \"\$tmp_whl\" '${ORT_WHEEL_URL}'
    python3 -c \"
import pathlib, zipfile
with zipfile.ZipFile('\$tmp_whl') as z:
    for name in z.namelist():
        if 'libonnxruntime' in name:
            (pathlib.Path('${ORT_DIR}') / pathlib.Path(name).name).write_bytes(z.read(name))
\"
  fi
"

if [ ! -f "${MODEL_PATH}" ]; then
  echo "Downloading Depth Pro 2 S streaming ONNX model..."
  curl -fsSL --retry 3 -o "${MODEL_PATH}.tmp" "${MODEL_URL}"
  mv "${MODEL_PATH}.tmp" "${MODEL_PATH}"
fi

if [ ! -f "${VIDEO_PATH}" ]; then
  echo "Downloading Depth Pro 2 sample video..."
  curl -fsSL --retry 3 -o "${VIDEO_PATH}.tmp" "${VIDEO_URL}"
  mv "${VIDEO_PATH}.tmp" "${VIDEO_PATH}"
fi

echo "VM '${VM_NAME}' is provisioned."
echo "  Model: ${MODEL_PATH}"
echo "  Video: ${VIDEO_PATH}"
